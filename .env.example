# App
APP_ENV=local
APP_NAME=healthcare-ai-platform

# API
API_HOST=0.0.0.0
API_PORT=8000

# OpenAI / LLM (server-side only; never exposed to the browser)
# LLM_MODE=mock (default): deterministic agents, no API key needed.
# LLM_MODE=real: calls OpenAI; startup fails if OPENAI_API_KEY is empty. No fallback to mock.
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-request timeout and retries for transient failures (timeouts, connection errors, 429, 5xx)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# PostgreSQL
POSTGRES_USER=healthcare_ai
POSTGRES_PASSWORD=healthcare_ai
POSTGRES_DB=healthcare_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Used by an API run on the host (uvicorn). The Compose api service builds its own URL from the values above with host `db`.
DATABASE_URL=postgresql+psycopg2://healthcare_ai:healthcare_ai@localhost:5432/healthcare_ai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS (comma-separated browser origins allowed to call the API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
